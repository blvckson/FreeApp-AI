# Copy to .env and set a private, long random key.
LLAMA_API_KEY=replace-with-a-long-random-secret
MODEL_FILE=SmolLM2-1.7B-Instruct-Q4_K_M.gguf
MODEL_ALIAS=freeapp-ai-base
MODEL_CONTEXT_SIZE=4096

# Optional model replacement overrides for download-model.sh:
# MODEL_URL=https://your-host/model.gguf
# MODEL_FILENAME=model.gguf
# MODEL_SHA256=<64-character-sha256>
